# 复制到项目根目录 .env.shenergy，按实际环境填写；不要提交或分享实际配置。
# 建表工匠：URL 为平台地址；账号或 token 按实际认证方式填写。
TABLEFORGE_URL=
TABLEFORGE_USERNAME=
TABLEFORGE_PASSWORD=
TABLEFORGE_TOKEN=

# 源 MySQL：填写只读账号；按实际连接要求填写端口及 TLS 参数。
SOURCE_MYSQL_HOST=
SOURCE_MYSQL_PORT=3306
SOURCE_MYSQL_DATABASE=
SOURCE_MYSQL_USER=
SOURCE_MYSQL_PASSWORD=
SOURCE_MYSQL_SSL_MODE=

# 目标 PostgreSQL：探查使用只读账号，不因此获得写库授权。
TARGET_PG_HOST=
TARGET_PG_PORT=5432
TARGET_PG_DATABASE=
TARGET_PG_USER=
TARGET_PG_PASSWORD=
TARGET_PG_SSLMODE=
